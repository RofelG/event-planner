# Port the API server listens on (PORT takes precedence if set).
API_PORT=3001

# development or production. Production enables Secure cookies and serves dist/.
NODE_ENV="development"

# Log verbosity: fatal, error, warn, info, debug, trace or silent. Development
# logs are pretty-printed; production logs are JSON lines on stdout.
LOG_LEVEL=info

# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_KEY=""

# MySQL connection (docker compose uses these to create the database and user).
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="event_planner"
DB_PASS="change-me"
DB_DB="event_planner"
DB_ROOT_PASS="change-me-root"

# Accounts created by `npm run db:seed` (development only; change these).
SEED_ADMIN_EMAIL="admin@example.test"
SEED_ADMIN_PASSWORD="ChangeMe-Admin-1"
SEED_PLANNER_EMAIL="planner@example.test"
SEED_PLANNER_PASSWORD="ChangeMe-Planner-1"
SEED_USER_EMAIL="user@example.test"
SEED_USER_PASSWORD="ChangeMe-User-1"

# Demo mode: a public showcase. Visitors browse without an account and give a
# name to join or create events. Showcase events get simulated attendees, and
# events created by visitors are removed after DEMO_EVENT_TTL_HOURS.
# Use a separate database (DB_DB) for a demo: it adds ~160 simulated users.
DEMO_MODE=false
DEMO_EVENT_TTL_HOURS=48
# Set to false to keep demo mode but stop the simulated sign-ups.
DEMO_SIMULATE=true
