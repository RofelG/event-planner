# On the server: copy to .env and fill in. Never commit it.
# Read by docker-compose.prod.yml (app, db and caddy).

NODE_ENV=production

# Public domain Caddy serves over HTTPS. Its DNS A/AAAA record must point at this server.
DOMAIN=events.example.com

# Secret used to sign JWTs (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_KEY=replace-with-generated-value

# MySQL. The compose file overrides DB_HOST with the service name "db".
DB_HOST=db
DB_PORT=3306
DB_USER=event_planner
DB_PASS=replace-with-strong-password
DB_DB=event_planner
DB_ROOT_PASS=replace-with-strong-root-password

# Port the API listens on inside the container (Caddy proxies to 3001).
API_PORT=3001

# Public address of the site (https://DOMAIN). Password reset emails link here.
APP_URL=https://events.example.com

# Outgoing email for password resets, from your mail provider's SMTP settings.
# Without SMTP_HOST no email is sent, so nobody can reset a password.
SMTP_HOST=smtp.example.com
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
# Use an address your provider allows you to send from.
MAIL_FROM="Event Planner <no-reply@events.example.com>"

# Demo mode adds ~160 simulated users: use a separate DB_DB if you enable it.
DEMO_MODE=false
DEMO_EVENT_TTL_HOURS=48
DEMO_SIMULATE=true
