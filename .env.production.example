# On the server: copy to .env and fill in. Never commit it.
# Read by docker-compose.prod.yml (app, db and caddy).

NODE_ENV=production

# Public domain Caddy serves over HTTPS. Its DNS A/AAAA record must point at this server.
DOMAIN=events.example.com

# Secret used to sign JWTs (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_KEY=replace-with-generated-value

# MySQL. The compose file overrides DB_HOST with the service name "db".
DB_HOST=db
DB_PORT=3306
DB_USER=event_planner
DB_PASS=replace-with-strong-password
DB_DB=event_planner
DB_ROOT_PASS=replace-with-strong-root-password

# Port the API listens on inside the container (Caddy proxies to 3001).
API_PORT=3001

# Demo mode adds ~160 simulated users: use a separate DB_DB if you enable it.
DEMO_MODE=false
DEMO_EVENT_TTL_HOURS=48
DEMO_SIMULATE=true
